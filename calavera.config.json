{
  "$schema": "https://calavera.schalkneethling.com/calavera.config.schema.json",
  "version": 1,
  "profile": "modern",
  "packageManager": "pnpm",
  "integrations": [
    "editorconfig",
    "typescript",
    "stylelint",
    "stylelint-standard",
    "stylelint-order",
    "stylelint-baseline",
    "css-property-type-validator"
  ],
  "scripts": {
    "lint": true,
    "lint:fix": true,
    "format": true,
    "format:check": true,
    "typecheck": true,
    "quality": true
  }
}

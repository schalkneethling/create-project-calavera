#!/usr/bin/env bash
# A stand-in for the GitHub CLI in these eval cases. Eval runs have no network
# and no GitHub login, so this answers the read-only commands the reviewer uses
# from a recording of schalkneethling/schalkneethling.com pull request 1457,
# taken on 2026-10-19 (issue #713). It fails where gh would fail, and on any
# command or flag that was not recorded, so the eval accepts no more than gh.
set -u

data="$(cd "$(dirname "$0")" && pwd)/data"
expected_repo="schalkneethling/schalkneethling.com"
json="" jq_expr="" job="" log="" repo="" method="GET"
positional=()

fail() {
  echo "$1" >&2
  exit 1
}

while [ $# -gt 0 ]; do
  case "$1" in
    --json) json="${2:-}"; shift 2 ;;
    --json=*) json="${1#--json=}"; shift ;;
    --jq | -q) jq_expr="${2:-}"; shift 2 ;;
    --jq=*) jq_expr="${1#--jq=}"; shift ;;
    --job) job="${2:-}"; shift 2 ;;
    --job=*) job="${1#--job=}"; shift ;;
    --log-failed) log="failed"; shift ;;
    -R | --repo) repo="${2:-}"; shift 2 ;;
    --repo=*) repo="${1#--repo=}"; shift ;;
    -X | --method) method="${2:-}"; shift 2 ;;
    -H | --header) shift 2 ;;
    --paginate) shift ;;
    --log) fail "gh (eval recording): only the failed steps were recorded; use --log-failed" ;;
    -*) fail "gh (eval recording): the flag $1 was not recorded for this eval" ;;
    *) positional+=("$1"); shift ;;
  esac
done

# The workspace has no git remote, so gh cannot infer the repository.
require_repo() {
  [ -n "$repo" ] || fail "could not determine the repository: this directory has no git remote; pass -R <owner>/<repo>"
  [ "$repo" = "$expected_repo" ] || fail "HTTP 404: Not Found (https://api.github.com/repos/$repo)"
}

# Sets pr_data to the folder that holds a pull request's recording: data/ for
# 1457, and data/pr-<number>/ for each further pull request a case adds.
require_pull_request() {
  local number=""
  case "${1:-}" in
    */"$expected_repo"/pull/*) number="${1#*/"$expected_repo"/pull/}"; number="${number%%/*}" ;;
    "" | *[!0-9]*) ;;
    *) require_repo; number="$1" ;;
  esac
  if [ "$number" = "1457" ]; then
    pr_data="$data"
  elif [ -n "$number" ] && [ -d "$data/pr-$number" ]; then
    pr_data="$data/pr-$number"
  else
    fail "GraphQL: Could not resolve to a PullRequest with the number of ${number:-${1:-}}. (repository.pullRequest)"
  fi
}

# Prints the folder whose recording holds run-<id>.json, across all pull requests.
run_folder() {
  local folder
  for folder in "$data" "$data"/pr-*; do
    [ -f "$folder/run-$1.json" ] && { echo "$folder"; return; }
  done
}

# Prints a recorded JSON file, keeping only the --json fields, then applies --jq.
# Like gh, an unknown field is an error that lists the available ones.
emit_json() {
  local file="$1" filter="."
  if [ -n "$json" ]; then
    local available field
    available="$(jq -r 'if type == "array" then (map(keys) | add // []) else keys end | unique | .[]' "$file")"
    for field in ${json//,/ }; do
      if ! grep -qx "$field" <<< "$available"; then
        printf 'Unknown JSON field: "%s"\nAvailable fields:\n%s\n' "$field" "$(sed 's/^/  /' <<< "$available")" >&2
        exit 1
      fi
    done
    filter="if type == \"array\" then map({${json}}) else {${json}} end"
  fi
  if [ -n "$jq_expr" ]; then
    jq "$filter" "$file" | jq -r "$jq_expr"
  else
    jq "$filter" "$file"
  fi
}

command="${positional[0]:-} ${positional[1]:-}"

case "$command" in
  "pr view")
    require_pull_request "${positional[2]:-}"
    if [ -n "$json" ]; then
      emit_json "$pr_data/pr-view.json"
    else
      jq -r '"\(.title) #\(.number)\n\(.state) • \(.author.login) wants to merge into \(.baseRefName) from \(.headRefName)\n\n\(.body)"' "$pr_data/pr-view.json"
    fi
    ;;
  "pr diff")
    require_pull_request "${positional[2]:-}"
    cat "$pr_data/pr.diff"
    ;;
  "pr checks")
    require_pull_request "${positional[2]:-}"
    # Like gh (pkg/cmd/pr/checks/checks.go in cli/cli), no checks is an error,
    # with --json too, because gh stops before it writes any output.
    if [ "$(jq length "$pr_data/pr-checks.json")" = "0" ]; then
      fail "no checks reported on the '$(jq -r .headRefName "$pr_data/pr-view.json")' branch"
    fi
    if [ -n "$json" ]; then
      # With --json, gh exits 0 whatever the checks' states.
      emit_json "$pr_data/pr-checks.json"
      exit 0
    fi
    cat "$pr_data/pr-checks.txt"
    # Like gh: exit 1 when a check failed, 8 when one is pending, else 0.
    if jq -e 'any(.[]; .bucket == "fail" or .bucket == "cancel")' "$pr_data/pr-checks.json" > /dev/null; then
      exit 1
    elif jq -e 'any(.[]; .bucket == "pending")' "$pr_data/pr-checks.json" > /dev/null; then
      exit 8
    fi
    ;;
  "run list")
    require_repo
    emit_json "$data/runs.json"
    ;;
  "run view")
    require_repo
    run="${positional[2]:-}"
    if [ -n "$job" ]; then
      # Like gh, a job ID decides the run, whatever run ID was given.
      run=""
      for file in "$data"/run-*.json "$data"/pr-*/run-*.json; do
        [ -f "$file" ] || continue
        if jq -e --arg job "$job" 'any(.jobs[]; (.databaseId | tostring) == $job)' "$file" > /dev/null; then
          run="$(basename "$file" .json)"
          run="${run#run-}"
        fi
      done
      [ -n "$run" ] || fail "failed to get job: HTTP 404: Not Found (https://api.github.com/repos/$repo/actions/jobs/$job)"
    fi
    run_data="$(run_folder "$run")"
    [ -n "$run_data" ] || fail "failed to get run: HTTP 404: Not Found (https://api.github.com/repos/$repo/actions/runs/$run)"
    if [ -n "$log" ]; then
      # Errors as gh prints them (pkg/cmd/run/view/view.go in cli/cli): no log
      # while a job or run is in progress, and "log not found" for a log GitHub
      # no longer has, such as one past its retention period.
      if [ -n "$job" ]; then
        job_status="$(jq -r --arg job "$job" '.jobs[] | select((.databaseId | tostring) == $job) | .status' "$run_data/run-$run.json")"
        [ "$job_status" = "completed" ] || fail "job $job is still in progress; logs will be available when it is complete"
      fi
      [ "$(jq -r .status "$run_data/run-$run.json")" = "completed" ] \
        || fail "run $run is still in progress; logs will be available when it is complete"
      # The recording holds the failed steps only, which is what --log-failed
      # returns. A run without failed steps has no recording and prints nothing.
      # A failed run without a recording stands for a log GitHub no longer has.
      if [ ! -f "$run_data/run-$run-log-failed.txt" ]; then
        [ "$(jq -r .conclusion "$run_data/run-$run.json")" = "failure" ] && fail "failed to get run log: log not found"
        exit 0
      fi
      if [ -n "$job" ]; then
        name="$(jq -r --arg job "$job" '.jobs[] | select((.databaseId | tostring) == $job) | .name' "$run_data/run-$run.json")"
        awk -F '\t' -v name="$name" '$1 == name' "$run_data/run-$run-log-failed.txt"
      else
        cat "$run_data/run-$run-log-failed.txt"
      fi
    elif [ -n "$json" ]; then
      emit_json "$run_data/run-$run.json"
    else
      cat "$run_data/run-$run.txt"
    fi
    ;;
  "api "*)
    [ "$method" = "GET" ] || fail "gh (eval recording): only GET requests were recorded"
    path="${positional[1]#/}"
    path="${path%%\?*}"
    case "$path" in
      repos/sveltejs/devalue/releases)
        emit_json "$data/devalue-releases.json"
        ;;
      repos/sveltejs/devalue/releases/tags/*)
        tag="${path##*/}"
        release="$(jq -c --arg tag "$tag" '.[] | select(.tag_name == $tag)' "$data/devalue-releases.json")"
        [ -n "$release" ] || fail "gh: Not Found (HTTP 404)"
        if [ -n "$jq_expr" ]; then
          jq -r "$jq_expr" <<< "$release"
        else
          jq . <<< "$release"
        fi
        ;;
      *) fail "gh: Not Found (HTTP 404)" ;;
    esac
    ;;
  "auth status")
    echo "github.com"
    echo "  ✓ Logged in to github.com account eval-recording"
    ;;
  *)
    fail "gh (eval recording): \"gh ${positional[*]:-}\" was not recorded for this eval"
    ;;
esac

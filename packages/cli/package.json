{
  "name": "create-project-calavera",
  "version": "7.0.0",
  "description": "Compose and apply modern tooling recipes for JavaScript and TypeScript projects.",
  "keywords": [
    "cli",
    "css",
    "html",
    "javascript",
    "linting",
    "project",
    "scaffold",
    "starter",
    "stylelint",
    "tooling"
  ],
  "homepage": "https://github.com/schalkneethling/create-project-calavera#readme",
  "bugs": {
    "url": "https://github.com/schalkneethling/create-project-calavera/issues"
  },
  "license": "MIT",
  "author": "Schalk Neethling",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/schalkneethling/create-project-calavera.git",
    "directory": "packages/cli"
  },
  "bin": {
    "create-project-calavera": "bin/create-project-calavera.js",
    "create-project-calavera-mcp": "bin/create-project-calavera-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": "./src/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "schema:check": "node --import ./scripts/test-environment.mjs --test scripts/check-config-schema.test.mjs scripts/check-artifact-contracts.test.mjs",
    "test": "node --import ./scripts/test-environment.mjs --test scripts/*.test.mjs",
    "smoke:node-floor": "node --import ./scripts/test-environment.mjs scripts/node-floor-smoke.mjs",
    "publish:check": "publint"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@schalkneethling/calavera-artifact-core": "workspace:^",
    "@schalkneethling/calavera-baseline-core": "workspace:^",
    "editorconfig": "^3.0.2",
    "execa": "^10.2.1",
    "jsonc-parser": "^3.3.1",
    "semver": "7.8.6",
    "signal-exit": "^4.1.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@yarnpkg/fslib": "^3.1.5",
    "@yarnpkg/libzip": "^3.2.2",
    "prettier": "^3.10.1"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  }
}

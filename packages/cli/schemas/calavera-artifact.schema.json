{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calavera.schalkneethling.com/schemas/calavera-artifact.schema.json",
  "title": "Calavera artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "displayName", "payload", "compatibility"],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri",
      "const": "https://calavera.schalkneethling.com/schemas/calavera-artifact.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(?:skill|hook|agent)-[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "type": {
      "enum": ["skill", "hook", "agent"]
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "$ref": "#/$defs/relativePath"
    },
    "targets": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(?!(?:\\.|\\.\\.)$)[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calavera"],
      "properties": {
        "calavera": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "inputs": {
      "description": "Values the person supplies when the artifact is selected. A recipe records the answers on the artifact's entry, and wiring commands reference them as {{name}}.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z][A-Za-z0-9]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "check"],
        "properties": {
          "prompt": {
            "description": "The question Calavera asks for the value.",
            "type": "string",
            "minLength": 1
          },
          "default": {
            "description": "How Calavera finds the suggested value. current-branch reads git symbolic-ref --short HEAD and has no value on a detached HEAD.",
            "enum": ["current-branch"]
          },
          "check": {
            "description": "How Calavera validates the value. branch-name requires a name that git check-ref-format --branch accepts unchanged.",
            "enum": ["branch-name"]
          }
        }
      }
    },
    "wiring": {
      "description": "Project files apply wires the installed skill into, under the same dry-run approval as the skill itself.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "viteHooks": {
          "description": "A command line per Git hook. Apply writes each one into an owned block of .vite-hooks/<hook>.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "enum": ["pre-commit", "prepare-commit-msg", "pre-push"] },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[^\\r\\n]+$"
          }
        },
        "claudeCode": {
          "description": "The payload path of a Claude Code settings fragment whose hook groups apply merges into .claude/settings.json.",
          "$ref": "#/$defs/relativePath"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "skill" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "id": { "type": "string", "pattern": "^skill-" } },
        "not": { "required": ["targets"] }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "hook" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "id": { "type": "string", "pattern": "^hook-" } },
        "required": ["targets"],
        "not": { "anyOf": [{ "required": ["inputs"] }, { "required": ["wiring"] }] }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "agent" } },
        "required": ["type"]
      },
      "then": {
        "properties": { "id": { "type": "string", "pattern": "^agent-" } },
        "required": ["targets"],
        "not": { "anyOf": [{ "required": ["inputs"] }, { "required": ["wiring"] }] }
      }
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
    }
  }
}
